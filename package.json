  "bugs": {
    "url": "https://github.com/Christianrvdv/christianrvdv/issues"
  },
  "homepage": "https://github.com/Christianrvdv/christianrvdv#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19"
  }
